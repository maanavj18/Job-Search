{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".venv/Scripts/python.exe .cursor/hooks/improve_loop.py",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".venv/Scripts/python.exe .cursor/hooks/improve_loop.py",
        "timeout": 15,
        "loop_limit": 5
      }
    ]
  }
}
